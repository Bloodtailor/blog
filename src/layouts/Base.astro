---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Aaron Orelup's notes on learning AI." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Aaron Orelup" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Delius+Unicase:wght@400;700&family=JetBrains+Mono:wght@400;500;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Zen+Maru+Gothic:wght@700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/">AARON ORELUP</a>
        <nav class="site-nav">
          <a href="/ledger">Ledger</a>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        &copy; {new Date().getFullYear()} Aaron Orelup. Notes on learning AI, filed as I go.
      </div>
    </footer>
  </body>
</html>
